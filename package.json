{
  "name": "pi-kiro-api",
  "version": "0.4.0",
  "description": "Kiro API-key provider for pi using KIRO_API_KEY. Vendors pi-kiro's streaming core (MIT) with no runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "kiro",
    "provider"
  ],
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "main": "./extension.ts",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "ci": "bun run check && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spi-ca/pi-kiro-api.git"
  },
  "homepage": "https://github.com/spi-ca/pi-kiro-api#readme",
  "bugs": "https://github.com/spi-ca/pi-kiro-api/issues",
  "author": "spi-ca",
  "files": [
    "extension.ts",
    "src",
    "README.md",
    "docs/**/*",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
